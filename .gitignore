# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyd
*.egg-info/
.eggs/
build/
.venv/
venv/
env/
pip-wheel-metadata/
*.whl

# --- Tooling and test caches ---------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Secrets and local config --------------------------------------------
# The tracked template is .env.example. A real .env can hold GEMINI_API_KEY and must
# never be committed; neither may any other .env variant.
.env
.env.*
!.env.example

# --- Runtime output -------------------------------------------------------
*.log
.tmp/

# --- Node / frontend ------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*

# --- Editors and OS -------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Build artifacts ------------------------------------------------------
# scripts/package.py writes the deliverable archive to dist/ inside the repo. Never write it
# into the shared workspace root: that directory holds other projects.
/dist/
*.zip

# --- Terraform ------------------------------------------------------------
# Providers and modules downloaded by `terraform init` (the Compose provisioner writes these
# into the mounted infra/ directory).
infra/**/.terraform/
infra/**/.terraform.tfstate.lock.info
# Local state contains resource ids and can contain secrets: never commit it.
infra/**/*.tfstate
infra/**/*.tfstate.*
# Environment-specific values. The tracked template is terraform.tfvars.example.
infra/**/*.tfvars
!infra/**/*.tfvars.example
infra/**/*.tfplan
infra/**/crash.log
# .terraform.lock.hcl is deliberately NOT ignored: committing it pins provider versions so every
# machine and CI resolves the same provider build.

# Deliberately NOT ignored:
#   samples/*.pdf          - three small fixtures the reviewer needs
#   requirements*.txt      - the pinned dependency set, effectively the lockfile
#   frontend/package-lock.json - reproducible npm install
