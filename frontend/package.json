{
  "name": "assessment-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Same-origin SPA for the async PDF processing assessment (upload, poll, render results).",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-sanitize": "^6.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "26.1.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "2.1.9"
  }
}
