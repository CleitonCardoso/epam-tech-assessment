#!/bin/bash
# Bootstrap for the application host: Docker, the compose plugin, and the deploy directory.
# Kept intentionally small — application configuration is NOT baked in here (no secrets in
# user_data, which is visible in the instance metadata and in the AWS console).
set -euo pipefail
exec > >(tee -a /var/log/app-bootstrap.log) 2>&1

echo "== installing docker + git"
dnf install -y docker git >/dev/null
systemctl enable --now docker

echo "== docker compose plugin"
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

echo "== app directory"
mkdir -p "${app_dir}"
chown ec2-user:ec2-user "${app_dir}"

echo "== done: put the compose stack and .env in ${app_dir}, then 'docker compose up -d'"
