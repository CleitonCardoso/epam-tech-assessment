# Environment template for the PDF-processing app.
#
#   cp .env.example .env
#
# Every value below is the exact default in app/config.py, so copying this file changes
# nothing; the app already defaults to the Compose network. An identical variable name is
# the upper-cased Settings field. Compose also reads this file (when named .env) for
# ${...} interpolation of the fields it needs, e.g. S3_BUCKET.
#
# Never commit a real .env; .dockerignore and .gitignore keep it out.

# ── wiring ────────────────────────────────────────────────────────────────────
# Compose-network addresses. For a host-side run, use redis://localhost:6379/0 and
# http://localhost:4566.
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT_URL=http://localstack:4566
# One name feeds both Terraform (the provisioner runs with TF_VAR_bucket_name=$S3_BUCKET) and the
# app, so they can never disagree. Changing it DESTROYS and re-creates the bucket: the name is the
# resource identity, and any stored PDFs go with it.
S3_BUCKET=documents
AWS_REGION=us-east-1
# LocalStack accepts any credentials; these are not secrets.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ── AI ────────────────────────────────────────────────────────────────────────
# live  -> real provider calls. With no GEMINI_API_KEY NO parser is enabled and uploads return
#          503 with that reason, because every document must end with a Gemini summary; /health/ready
#          is 503 too. live NEVER falls back to the fake implementation.
# fake  -> explicit, labelled, deterministic stand-in for tests/demos without credentials.
#          Reported as ai_mode=fake in /api/v1/parsers, /health/ready (checks.ai_mode) and
#          the worker startup log. No network, same input -> same output.
# To demo without credentials:  AI_MODE=fake
# Or skip this file entirely and pass the key to Compose (see README, "Bring your own key"):
#   GEMINI_API_KEY=... docker compose up --build -d
AI_MODE=live
GEMINI_API_KEY=
# The brief's model id. If it answers 503 UNAVAILABLE ("high demand"), a same-family alias works
# for a demo: GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ── limits ────────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=20971520
MAX_BATCH_FILES=5
MAX_BATCH_BYTES=52428800
MAX_PAGES=50
MAX_AI_PAGES=20
MAX_EXTRACTED_CHARS=200000
# Uploads buffer their file in memory before the S3 write, so this is the memory ceiling:
# concurrent_uploads x batch bytes. Past it, requests wait briefly then get a 503 + Retry-After.
MAX_CONCURRENT_UPLOADS=16
UPLOAD_SLOT_TIMEOUT_SECONDS=10.0
PROVIDER_TIMEOUT_SECONDS=60.0
# Pacing for provider calls. MAX_CONCURRENCY bounds simultaneous requests per worker process;
# MAX_REQUESTS_PER_MINUTE enables a token bucket (0 = disabled). Set the RPM to your provider's
# published limit and 429s become slower throughput instead of failed documents.
PROVIDER_MAX_CONCURRENCY=4
PROVIDER_MAX_REQUESTS_PER_MINUTE=0
# A provider Retry-After longer than this is clamped, so a throttled call cannot hold a job past
# its deadline.
RETRY_AFTER_MAX_SECONDS=30.0

# ── job lifecycle ─────────────────────────────────────────────────────────────
MAX_JOB_ATTEMPTS=3
JOB_DEADLINE_SECONDS=600
LEASE_SECONDS=90
HEARTBEAT_SECONDS=15
RESULT_TTL_SECONDS=86400
# JSON array of seconds; validation rejects an empty list.
RETRY_BACKOFF_SECONDS=[2.0, 5.0, 10.0]

# ── queue ─────────────────────────────────────────────────────────────────────
STREAM_KEY=docs:jobs
CONSUMER_GROUP=document-workers
WORKER_READ_BLOCK_MS=2000
# 0 means "derive from LEASE_SECONDS at runtime".
RECLAIM_MIN_IDLE_MS=0
# Jobs processed in parallel by one worker process. This is the throughput knob: raise it to
# process more documents at once, bounded by the host's memory (each in-flight job holds its PDF
# and extracted pages). Two workers with 4 slots each is the same as one worker with 8.
WORKER_CONCURRENCY=4
# Stream entries fetched per read; keep it >= WORKER_CONCURRENCY.
WORKER_BATCH_SIZE=8
# On SIGTERM, how long in-flight jobs may keep running before the worker exits. Anything left
# unfinished stays pending and is reclaimed after the lease expires.
WORKER_SHUTDOWN_GRACE_SECONDS=30.0

# ── diagnostics ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Deterministic latency (seconds) for FakeParser/FakeSummarizer in fake mode.
FAKE_DELAY_SECONDS=0.0

# ── compose only (not read by the app) ────────────────────────────────────────
# Host port that publishes the LocalStack S3 API. Inside the Compose network the app always
# uses localstack:4566; change this only when 4566 is already taken on your machine.
LOCALSTACK_PORT=4566
